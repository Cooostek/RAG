#Тут переменные окружения
#отделяет конфигурации от кода

MILVUS_HOST=standalone
MILVUS_PORT=19530
MILVUS_COLLECTION_ALIAS=knowledge_base_current

OLLAMA_BASE_URL=http://host.docker.internal:11434
#Тупенькая модель
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=180

PARSER_BASE_URL=https://micro.im/
PARSER_START_URL=https://micro.im/docs/smarty/portal-and-apps-settings

#Это для гибридного поиска коэф смещения
SEARCH_ALPHA=0.6
SEARCH_TOPK_DEFAULT=5
SEARCH_TOPK_MAX=20
MAX_CONTEXT_CHARS=7000

#это уровень логирования (старт, ключевые действия)
LOG_LEVEL=INFO
